index 8db293a..0a3ac5d 100644
--- a/Common/MemArenaPosix.cpp
+++ b/Common/MemArenaPosix.cpp
@@ -16,6 +16,7 @@
 // http://code.google.com/p/dolphin-emu/
 
 #include "ppsspp_config.h"
+#include <cstdlib>
 
 #if !defined(_WIN32) && !defined(ANDROID) && !defined(__APPLE__) && !PPSSPP_PLATFORM(SWITCH)
 
@@ -174,8 +175,17 @@ u8* MemArena::Find4GBBase() {
 		return hardcoded_ptr;
 	}
 #elif defined(NO_MMAP)
-    void* base = std::malloc(0x0A000000);
-    return static_cast<u8*>(base);
+	// Must cover everything MEMVIEW32_MASK (0x0FFFFFFF on 32-bit) can reach: the views go at
+	// base + (address & mask), and 64 MB of Slim RAM alone ends at 0x0C000000. A smaller block lets
+	// PSP addresses past its end write into the host heap.
+	// Allocated once and reused: nothing releases it, and a new 256 MB block per boot would
+	// exhaust a 32-bit address space after a few games or tests.
+	static void *base = nullptr;
+	if (!base)
+		base = std::malloc(0x10000000);
+	if (base)
+		memset(base, 0, 0x10000000);
+	return static_cast<u8*>(base);
 #else
 	// Keep the range reserved and map the views over it, so nothing else can be allocated in the gaps
 	// between them, or where a view is about to go (see MemArenaAndroid.cpp).
