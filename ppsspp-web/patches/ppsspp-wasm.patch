@@ -1,4 +1,39 @@
 
+#ifdef __EMSCRIPTEN__
+#include <atomic>
+#include <thread>
+#include <emscripten.h>
+#include <emscripten/wasmfs.h>
+
+// The page mounts the browser's Origin Private File System at /opfs before calling main(), so
+// game files and the memory stick (saves, settings) persist. Creating the backend waits on the
+// main thread's event loop, so it runs on a helper thread and the page polls for the result.
+static std::atomic<int> g_webOpfsState{0};  // 0 = pending, 1 = mounted, -1 = failed
+
+extern "C" EMSCRIPTEN_KEEPALIVE void PPSSPPWeb_MountOPFS() {
+	std::thread([] {
+		backend_t backend = wasmfs_create_opfs_backend();
+		int result = backend ? wasmfs_create_directory("/opfs", 0777, backend) : -1;
+		g_webOpfsState = result == 0 ? 1 : -1;
+	}).detach();
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE int PPSSPPWeb_OPFSState() {
+	return g_webOpfsState;
+}
+
+// Progress counters for the page (debugging stalls): browser frames handled, emulator frames run,
+// and render-thread frames replayed.
+static std::atomic<int> g_webMainFrames{0}, g_webEmuFrames{0}, g_webReplayed{0};
+extern "C" EMSCRIPTEN_KEEPALIVE int PPSSPPWeb_Stat(int which) {
+	switch (which) {
+	case 0: return g_webMainFrames;
+	case 1: return g_webEmuFrames;
+	case 2: return g_webReplayed;
+	default: return -1;
+	}
+}
+#endif
 #include <cstdlib>
 #include <unistd.h>
 #include <pwd.h>
@@ -2042,6 +2077,48 @@ void UpdateSDLCursor() {
 #ifdef _WIN32
 #undef main
 #endif
+#ifdef __EMSCRIPTEN__
+// Browsers can't run a blocking loop on the main thread. The emulator runs on its own pthread
+// (EmuThread) and records GL commands; once per animation frame, the page's main thread handles
+// input and replays whatever the emulator has queued with WebGL2, then returns to the browser.
+struct WebLoop {
+	SDL_Window *window;
+	SDLGLGraphicsContext *gl;
+	InputStateTracker tracker{};
+};
+
+static void WebLoopFrame(void *arg) {
+	WebLoop *w = (WebLoop *)arg;
+	g_webMainFrames++;
+	SDL_Event event;
+	while (SDL_PollEvent(&event)) {
+		ProcessSDLEvent(w->window, event, &w->tracker);
+	}
+	if (g_QuitRequested || g_RestartRequested) {
+		emscripten_cancel_main_loop();
+		return;
+	}
+	UpdateTextFocus(w->window);
+	UpdateSDLCursor();
+	w->tracker.MouseCaptureControl(w->window);
+
+	// Replay the frames the emulator has finished, but never wait on an empty queue: that would
+	// freeze the page. A partly queued frame completes inside ThreadFrame.
+	for (int i = 0; i < 3 && w->gl->HasQueuedThreadWork(); i++) {
+		if (!w->gl->ThreadFrame()) {
+			emscripten_cancel_main_loop();
+			return;
+		}
+		g_webReplayed++;
+	}
+
+	std::lock_guard<std::mutex> guard(g_mutexWindow);
+	if (g_windowState.update) {
+		UpdateWindowState(w->window);
+	}
+}
+#endif
