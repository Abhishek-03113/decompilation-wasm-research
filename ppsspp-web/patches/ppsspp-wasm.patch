 		// to keep things uniform.
 		{
 			std::unique_lock<std::mutex> lock(pushMutex_);
+#ifdef __EMSCRIPTEN__
+			// In a browser this runs on the page's main thread, which must never wait on the emulator
+			// thread (it may itself be waiting for the main thread). The queue is the only state, so
+			// when the rest of the frame isn't queued yet, return and continue on the next animation frame.
+			if (renderThreadQueue_.empty())
